                                <button class="button button-primary" type="button">Primær</button>
                            </fds-modal-closer>
                            <fds-modal-closer class="button-wrapper" return-value="Sekundær">
                                <button class="button button-secondary" type="button">Sekundær</button>
                            </fds-modal-closer>
                        </div>
                    </div>
                </dialog>
            </fds-modal>
        </div>
    </div>

