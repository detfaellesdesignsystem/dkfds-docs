</main>

<script>
    const btn = document.querySelector('.transition-button');
    btn.addEventListener('transitionend', (event) => {
        console.log('Transition ended - button', event.target);
    }, false);

    document.getElementById('return-value-example').addEventListener("close", () => {
        console.log(`Dialog closed. Return value: "${document.getElementById('return-value-example').returnValue}"`);
    });
</script>