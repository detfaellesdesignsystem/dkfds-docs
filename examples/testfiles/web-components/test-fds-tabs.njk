<script>
    const tabsElement = document.getElementById('add-remove-tabs');
    const addButton = document.getElementById('add-tab-button');
    const removeButton = document.getElementById('remove-tab-button');

    let nextTabKey = 4; // The HTML already has tab-key 1, 2 and 3

    function getTabCount() {
        return tabsElement.querySelectorAll(':scope > fds-tab').length;
    }

    function addTab() {
        const tabKey = String(nextTabKey);
        nextTabKey++;

        const tab = document.createElement('fds-tab');
        tab.setAttribute('tab-key', tabKey);
        tab.textContent = `Faneblad ${tabKey}`;

        const panel = document.createElement('fds-tab-panel');
        panel.setAttribute('tab-key', tabKey);
        panel.textContent = `Panel ${tabKey}`;

        tabsElement.append(tab, panel);
    }

    function removeLastTab() {
        const tabs = tabsElement.querySelectorAll(':scope > fds-tab');
        const panels = tabsElement.querySelectorAll(':scope > fds-tab-panel');

        if (tabs.length === 0) return;

        const lastTab = tabs[tabs.length - 1];
        const lastPanel = panels[panels.length - 1];

        lastTab.remove();
        lastPanel.remove();
    }

    addButton.addEventListener('click', addTab);
    removeButton.addEventListener('click', removeLastTab);
</script>